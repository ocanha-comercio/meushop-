# ============================================================
# MEUSHOP - Configuração de Credenciais dos Marketplaces
# ============================================================
# Copie este arquivo para .env e preencha com suas credenciais:
#   cp .env.example .env
# ============================================================

PORT=3001

# ─── MERCADO LIVRE ───────────────────────────────────────────
# Obtenha em: https://developers.mercadolivre.com.br
ML_CLIENT_ID=seu_client_id_aqui
ML_CLIENT_SECRET=seu_client_secret_aqui
ML_REDIRECT_URI=http://localhost:3001/auth/mercadolivre/callback
ML_ACCESS_TOKEN=seu_access_token_aqui
ML_REFRESH_TOKEN=seu_refresh_token_aqui
ML_SELLER_ID=seu_seller_id_aqui

# ─── SHOPEE ──────────────────────────────────────────────────
# Obtenha em: https://open.shopee.com
SHOPEE_PARTNER_ID=seu_partner_id_aqui
SHOPEE_PARTNER_KEY=sua_partner_key_aqui
SHOPEE_SHOP_ID=seu_shop_id_aqui
SHOPEE_ACCESS_TOKEN=seu_access_token_aqui

# ─── AMAZON (SP-API) ────────────────────────────────────────
# Obtenha em: https://sellercentral.amazon.com.br/sellingpartner/developerconsole
AMAZON_CLIENT_ID=seu_client_id_aqui
AMAZON_CLIENT_SECRET=seu_client_secret_aqui
AMAZON_REFRESH_TOKEN=seu_refresh_token_aqui
AMAZON_MARKETPLACE_ID=A2Q3Y263D00KWC
AMAZON_REGION=us-east-1
AMAZON_ROLE_ARN=arn:aws:iam::role/seu-role

# ─── TIKTOK SHOP ────────────────────────────────────────────
# Obtenha em: https://partner.tiktokshop.com
TIKTOK_APP_KEY=sua_app_key_aqui
TIKTOK_APP_SECRET=seu_app_secret_aqui
TIKTOK_ACCESS_TOKEN=seu_access_token_aqui
TIKTOK_SHOP_ID=seu_shop_id_aqui

# ─── MAGALU (MAGAZINE LUIZA) ────────────────────────────────
# Obtenha em: https://api-marketplace.magazineluiza.com.br
MAGALU_CLIENT_ID=seu_client_id_aqui
MAGALU_CLIENT_SECRET=seu_client_secret_aqui
MAGALU_ACCESS_TOKEN=seu_access_token_aqui
MAGALU_TENANT_ID=seu_tenant_id_aqui
